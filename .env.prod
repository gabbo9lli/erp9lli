# .env.prod (Production secrets and variables - KEEP THIS FILE SECURE)
DATABASE_URL=postgresql://gabbo:gabbino@db:5432/erp9lli_prod
FLASK_ENV=production
FLASK_COMMAND=gunicorn --worker-class gevent --workers 4 --bind 0.0.0.0:8000 --timeout 120 app:app # Production-ready Gunicorn server
FLASK_DEBUG=0
VUE_APP_API_URL=/api/ # Used in the Vue build stage
DB_TYPE=postgresql

# Traefik & TLS Configuration
TRAEFIK_DOMAIN=erp.example.com
ACME_EMAIL=admin@example.com

# oauth2-proxy Configuration (OIDC Provider)
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_CLIENT_ID=erp-client
OAUTH2_PROXY_CLIENT_SECRET=erp-client-secret-change-in-prod
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.example.com/realms/erp
OAUTH2_PROXY_COOKIE_SECRET=12345678901234567890123456789012
OAUTH2_PROXY_COOKIE_SECURE=false
